  "actualPlacementFunctionSource": "function placement(frame, canvasWidth, canvasHeight) {\n  const [x, y, w, h] = frame.rect, [px, py] = frame.pivot || [0.5, 1];\n  const bodyHeight = frame.bodyBounds?.[3] || h;\n  const halfWidth = Math.max(0, canvasWidth / 2 - 14);\n  const leftExtent = px * w, rightExtent = (1 - px) * w;\n  const scale = Math.min((canvasHeight - 56) / bodyHeight, leftExtent > 0 ? halfWidth / leftExtent : Infinity, rightExtent > 0 ? halfWidth / rightExtent : Infinity);\n  return { x: canvasWidth / 2 - px * w * scale, y: canvasHeight - 20 - py * h * scale, width: w * scale, height: h * scale, scale, source: [x, y, w, h], groundY: canvasHeight - 20 };\n}",
