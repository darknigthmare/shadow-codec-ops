  "promptSpec": {
    "id": "pf-soldier",
    "generator": "OpenAI imagegen built-in",
    "prompt": "Use case stylized-concept. Production 2D pixel-art animation sheet of a Rogue Coyote private-force infantryman as seen in Metal Gear Solid V The Phantom Pain Central Africa. Original fan-made adaptation, faithfully matching the game's light infantry variant: adult dark-skinned man, olive-green short sleeve T-shirt, olive soft patrol cap with short brim, tan rectangular chest magazine rig, olive/tan woodland camouflage cargo trousers, dark brown combat boots, brown belt with pouches, black assault rifle with curved magazine. No balaclava, no Soviet helmet, no skull mask, no sci-fi armor, no beard or eyepatch. Realistic adult proportions and practical military silhouette in crisp detailed pixel clusters. EXACT4columns×4rows, 16 authored complete fullbody frames. All faceRIGHT in side orthographic view, same scale and footbaseline across all cells. Flatpure#FF00FF magenta background, thinpurecyan grid boundaries. Character and gun must remain inside central60% of each square cell with clear 20% magenta margins left/right, generous above head/below feet. Row1 idle four distinct breathing/head patrol phases with rifle lowered. Row2 move four genuinely alternating leg walking phases. Row3 attack raise rifle, aim, fire with small yellow muzzleflash, recoil. Row4 reaction flinch, crouch brace, recover, ready. No blood or gore, no text labels or UI or symbols, no floor shadow or scene, no clipped weapons, no duplicate translated poses.",
    "generatedFile": "exec-74dfdfb9-aad4-4899-9f1b-5082b351ceb2.png",
    "referenceUrls": [
      "https://www.deviantart.com/midian-p/art/MGSV-Rouge-Coyote-Soldiers-Render-869249283"
    ],
    "review": "Generated image visually reviewed for source silhouette and intact authored poses. Original pixel adaptation. References include mirrored official concept art or game-model fan renders, not redistributed official game files. No 1:1 claim.",
    "limitations": [
      "Representative Rogue Coyote light infantry uniform, not every PF faction/costume."
    ]
  },
